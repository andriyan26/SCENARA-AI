# ========================================================
# SCENARA AI - Konfigurasi Server Environment
# Salin file ini menjadi '.env' di folder server:
# cp .env.example .env
# ========================================================

# Port Server Backend
PORT=5000

# Mode Lingkungan (development / production)
NODE_ENV=development

# Mode AI Generator:
# 'mock' = menggunakan generator simulasi lokal beresolusi tinggi (tidak butuh API key berbayar)
# 'live' = menggunakan API pihak ketiga (Google Gemini, Runway Gen-3, ElevenLabs)
AI_MODE=mock

# Konfigurasi Database MySQL (Laragon / XAMPP / Native MySQL)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=scenara_ai

# Keamanan Token JWT
JWT_SECRET=scenara_super_secret_jwt_key_2026_cinematic_studio

# API Key Penyedia AI Eksternal (Opsional jika AI_MODE=mock)
GOOGLE_AI_API_KEY=
RUNWAY_API_KEY=
ELEVENLABS_API_KEY=

# Jalur Penyimpanan File Media Lokal
STORAGE_PATH=./storage

# URL Publik Backend
APP_URL=http://localhost:5000
